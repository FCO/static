use Test;
use lib 't/lib';
use Compile;
my ($code, $output) = compile('use StaticDependency; my Int $x = external-int()', :mode<fail-on-unverifiable>);
is $code, 0, 'external declared return is available';
unlike $output, /'$invalid'/, 'dependency body is outside the analysis';
($code, $output) = compile('use StaticDependency; my Int $x = external-text()');
is $code, 1, 'external signature mismatch';
like $output, /'[static:mismatch]'/, 'external call return checked';
($code, $output) = compile('use StaticDependency; my Int $x = external-int()', :options<:!external-signatures>, :mode<fail-on-unverifiable>);
is $code, 1, 'external signatures can be disabled';
like $output, /'external signatures disabled'/, 'disabled external metadata is inconclusive';
($code, $output) = compile('use StaticDependency; my Int $x = external-untyped()', :mode<fail-on-unverifiable>);
is $code, 1, 'external body is not used to infer its return';
like $output, /'external routine has no return contract'/, 'missing external contract reported';
($code, $output) = compile('subset P of Int where { die "PREDICATE EXECUTED" }; sub value() { 1 }; my P $x = value()', :mode<warn-on-unverifiable>);
is $code, 0, 'subset predicate does not execute';
like $output, /'[static:unverifiable]'/, 'subset membership is inconclusive';
unlike $output, /'PREDICATE EXECUTED'/, 'no user predicate evaluation';
($code, $output) = compile('sub f(Int $x where { die "PREDICATE EXECUTED" }) { 1 }; f(1)', :mode<warn-on-unverifiable>);
is $code, 0, 'where predicate does not execute';
like $output, /'[static:unverifiable]'/, 'where dispatch is inconclusive';
unlike $output, /'PREDICATE EXECUTED'/, 'no where predicate evaluation';
($code, $output) = compile('sub f(Int(Str) $x) { $x }; f("1")', :mode<fail-on-unverifiable>);
is $code, 1, 'coercion success is not assumed';
like $output, /'[static:unverifiable]'/, 'coercion execution remains a runtime matter';
($code, $output) = compile('my &f = sub { 1 }; my Int $x = f()', :mode<warn-on-unverifiable>);
is $code, 0, 'indirect call does not crash checker';
like $output, /'[static:unverifiable]'/, 'indirect call is inconclusive';
($code, $output) = compile('sub value() { "s" }; my int $x = value()');
is $code, 1, 'native contract rejects incompatible nominal type';
like $output, /'[static:mismatch]'/, 'native mismatch is diagnosed';
done-testing;
