use Test;
use lib 't/lib';
use Compile;

my @cases =
    ['readonly parameter assignment', 'sub a($a) { $a = 42 }', 'mismatch'],
    ['readonly typed parameter assignment', 'sub a(Int $a) { $a = 42 }', 'mismatch'],
    ['readonly named parameter assignment', 'sub a(:$a) { $a = 42 }', 'mismatch'],
    ['readonly parameter postfix', 'sub a($a) { $a++ }', 'mismatch'],
    ['readonly parameter prefix', 'sub a($a) { ++$a }', 'mismatch'],
    ['readonly parameter compound', 'sub a($a) { $a += 42 }', 'mismatch'],
    ['readonly parameter alias', 'sub a($a) { my $b := $a; $b = 42 }', 'mismatch'],
    ['writable copy assignment', 'sub a($a is copy) { $a = 42 }', 'ok'],
    ['writable rw assignment', 'sub a($a is rw) { $a = 42 }', 'ok'],
    ['raw parameter assignment', 'sub a($a is raw) { $a = 42 }', 'unverifiable'],
    ['array parameter assignment', 'sub a(@a) { @a = 42 }', 'ok'],
    ['hash parameter assignment', 'sub a(%a) { %a = a => 42 }', 'ok'],
    ['rw aggregate is not scalar', 'sub f($x is rw) {1}; my @a=1; f(@a)', 'mismatch'],
    ['bound aggregate is not scalar', 'my @a=1; my $x := @a; $x=42', 'mismatch'],
    ['rw singleton list', 'sub f($x is rw) {1}; my $n=1; f(($n,))', 'mismatch'],
    ['rw lexical', 'sub f(Int $x is rw) { $x=2 }; my Int $n=1; f($n)', 'ok'],
    ['rw untyped scalar', 'sub f(Int $x is rw) { $x=2 }; my $n=1; f($n)', 'ok'],
    ['rw literal', 'sub f(Int $x is rw) {1}; f(1)', 'mismatch'],
    ['rw expression', 'sub f(Int $x is rw) {1}; my $n=1; f($n+1)', 'mismatch'],
    ['rw readonly parameter', 'sub f(Int $x is rw) {1}; sub g(Int $x) {f($x)}', 'mismatch'],
    ['rw copy parameter', 'sub f(Int $x is rw) {1}; sub g(Int $x is copy) {f($x)}', 'ok'],
    ['rw named', 'sub f(Int :$x! is rw) {1}; my $n=1; f(:x($n))', 'ok'],
    ['rw named literal', 'sub f(Int :$x! is rw) {1}; f(:x(1))', 'mismatch'],
    ['rw constant', 'sub f(Int $x is rw) {1}; my constant N=1; f(N)', 'mismatch'],
    ['rw element', 'sub f(Int $x is rw) {1}; my Int @a=1; f(@a[0])', 'ok'],
    ['destructuring declaration', 'my (Int $x, Str $y)=1,"s"; my Int $z=$x', 'ok'],
    ['destructuring declaration mismatch', 'my (Int $x, Str $y)="s",1', 'mismatch'],
    ['destructuring assignment', 'my Int $x; my Str $y; ($x,$y)=1,"s"', 'ok'],
    ['destructuring assignment mismatch', 'my Int $x; my Str $y; ($x,$y)="s",1', 'mismatch'],
    ['destructuring propagation', 'my ($x,$y)=1,"s"; my Str $z=$x', 'mismatch'],
    ['destructuring slurpy', 'my (Int $x, *@rest)=1,2,3', 'ok'],
    ['sub-signature', 'sub f([Int $x, Str $y]) {1}; f([1,"s"])', 'ok'],
    ['sub-signature mismatch', 'sub f([Int $x, Str $y]) {1}; f(["s",1])', 'mismatch'],
    ['nested sub-signature', 'sub f([[Int $x], Str $y]) {1}; f([[1],"s"])', 'ok'],
    ['nested sub-signature mismatch', 'sub f([[Int $x], Str $y]) {1}; f([["s"],"s"])', 'mismatch'],
    ['literal binding', 'my $x := 1; my Int $y=$x', 'ok'],
    ['write literal binding', 'my $x := 1; $x=2', 'mismatch'],
    ['rw literal binding', 'sub f(Int $x is rw) {1}; my $x := 1; f($x)', 'mismatch'],
    ['alias chain', 'my Int $x=1; my $y := $x; my $z := $y; $z="bad"', 'mismatch'],
    ['element alias', 'my Int @a=1; my $x := @a[0]; $x="bad"', 'mismatch'],
    ['destructuring aliases', 'my Int $a=1; my Str $b="s"; my ($x,$y) := ($a,$b); $x="bad"', 'mismatch'],
    ['one dimension', 'my Int @a[2]=1,2; @a[1]=3', 'ok'],
    ['fixed dimension push', 'my Int @a[2]=1,2; @a.push(3)', 'mismatch'],
    ['fixed dimension pop', 'my Int @a[2]=1,2; @a.pop()', 'mismatch'],
    ['dimension overflow', 'my Int @a[2]=1,2,3', 'mismatch'],
    ['dimension partial initialization', 'my Int @a[3]=1', 'ok'],
    ['two dimensions', 'my Int @a[2;2]=(1,2),(3,4); @a[1;1]=5', 'ok'],
    ['dimension structure', 'my Int @a[2;2]=1,2,3,4', 'mismatch'],
    ['dimension inner overflow', 'my Int @a[2;2]=(1,2,3),(4,5)', 'mismatch'],
    ['dimension element mismatch', 'my Int @a[2;2]=(1,"bad"),(3,4)', 'mismatch'],
    ['index bounds', 'my Int @a[2]; @a[2]=1', 'mismatch'],
    ['index negative', 'my Int @a[2]; @a[-1]=1', 'mismatch'],
    ['index rank', 'my Int @a[2;2]; @a[1]=1', 'mismatch'],
    ['shape reassignment', 'my Int @a[2]; @a=1,2,3', 'mismatch'],
    ['dynamic dimension', 'sub f(Int $n) {my Int @a[$n]}', 'unverifiable'],
    ['given type', 'my Int $n=do given 1 {when Int {2}; default {"bad"}}', 'ok'],
    ['given mismatch', 'my Int $n=do given 1 {when Int {"bad"}; default {2}}', 'mismatch'],
    ['given topic', 'my Int $n=do given 1 {when Int {$_}}', 'ok'],
    ['given literal', 'my Int $n=do given "x" {when "x" {2}; default {"bad"}}', 'ok'],
    ['given boolean', 'my Int $n=do given "x" {when True {2}; default {"bad"}}', 'ok'],
    ['given unknown smartmatch', 'given 1 {when /x/ {1}}', 'unverifiable'],
    ['try normal', 'sub f() {try {die "x"}; 1}; my Int $n=f()', 'ok'],
    ['try body mismatch', 'try {my Int $n="bad"}', 'mismatch'],
    ['catch body mismatch', 'sub f() {CATCH {default {my Int $n="bad"}}; die "x"}; f()', 'mismatch'],
    ['catch after die', 'sub f() {die "x"; CATCH {default {my Int $n="bad"}}}; f()', 'mismatch'],
    ['control body mismatch', 'sub f() {CONTROL {default {my Int $n="bad"}}; 1}; f()', 'mismatch'],
    ['catch return contract', 'sub f(--> Int) {CATCH {default {}}; 1}; my Int $n=f()', 'ok'],
    ['caught return', 'sub f(--> Int) {CATCH {default {return "bad"}}; die "x"}; f()', 'mismatch'],
    ['try partial write', 'my $x=1; try {$x="bad"; die "x"}; my Int $n=$x', 'unverifiable'],
    ['gather head', 'my $s=gather {take 1}; my Int $n=$s.head', 'ok'],
    ['gather head mismatch', 'my $s=gather {take "bad"}; my Int $n=$s.head', 'mismatch'],
    ['gather typed collection', 'my Int @a=gather {take "bad"}', 'mismatch'],
    ['gather nested', 'my $s=gather {my $inner=gather {take "s"}; take 1}; my Int $n=$s.head', 'ok'],
    ['gather body mismatch', 'my $s=gather {my Int $n="bad"; take 1}', 'mismatch'],
    ['supply callback effects', 'my $x=1; my $s=supply {emit 1}; $s.tap(-> $n {$x="bad"}); my Int $v=$x', 'unverifiable'],
    ['promise head is not payload', 'my $p=start {1}; my Int $n=$p.head', 'unverifiable'],
    ['supply tap', 'my $s=supply {emit 1}; $s.tap(-> Int $n {})', 'ok'],
    ['supply tap mismatch', 'my $s=supply {emit "bad"}; $s.tap(-> Int $n {})', 'mismatch'],
    ['supply multiple emits', 'my $s=supply {emit 1; emit 2}; $s.tap(-> Int $n {})', 'ok'],
    ['supply mixed emits', 'my $s=supply {emit 1; emit "bad"}; $s.tap(-> Int $n {})', 'unverifiable'],
    ['deferred capture read', 'my $x=1; my $p=start {$x}; $x="bad"; my Int $n=await $p', 'unverifiable'],
    ['deferred write after reassignment', 'my $x=1; my $p=start {$x="bad"}; $x=2; my Int $n=$x', 'unverifiable'],
    ['typed deferred capture', 'my Int $x=1; my $p=start {$x}; my Int $n=await $p', 'ok'],
    ['supply nominal', 'my Supply $s=supply {emit 1}', 'ok'],
    ['supply nominal mismatch', 'my Int $n=supply {emit 1}', 'mismatch'],
    ['supply body mismatch', 'my $s=supply {my Int $n="bad"; emit 1}', 'mismatch'],
    ['start await', 'my $p=start {1}; my Int $n=await $p', 'ok'],
    ['start await mismatch', 'my $p=start {"bad"}; my Int $n=await $p', 'mismatch'],
    ['start result', 'my $p=start {1}; my Int $n=$p.result', 'ok'],
    ['start nominal mismatch', 'my Int $n=start {1}', 'mismatch'],
    ['start body mismatch', 'my $p=start {my Int $n="bad"; 1}', 'mismatch'],
    ['concurrent write', 'my $x=1; my $p=start {$x="bad"}; my Int $n=$x', 'unverifiable'],
    ['deferred write', 'my $x=1; my $s=gather {$x="bad"; take 1}; my Int $n=$x', 'unverifiable'],
    ['array reassignment snapshot', 'my @a=1,2; @a="a","bb"; my Int @b=@a».chars', 'ok'],
    ['collection reference invalidation', 'my @a=1,2; my $ref=@a; @a="a","b"; my Int $n=$ref[0]', 'unverifiable'],
    ['collection reference mutation', 'my $a=[1,2]; my $ref=$a; $a[0]="bad"; my Int $n=$ref[0]', 'unverifiable'],
    ['hyper method', 'my Int @a=("a","bb")».chars', 'ok'],
    ['hyper method mismatch', 'my Str @a=("a","bb")».chars', 'mismatch'],
    ['hyper missing method', 'my @a=(1,2)».does-not-exist()', 'mismatch'],
    ['hyper lexical array', 'my @a="a","bb"; my Int @b=@a».chars', 'ok'],
    ['hyper infix', 'my Int @a=(1,2) >>+<< (3,4)', 'ok'],
    ['hyper infix mismatch', 'my Str @a=(1,2) >>+<< (3,4)', 'mismatch'],
    ['hyper prefix', 'my Int @a=-<<(1,2)', 'ok'],
    ['hyper nested', 'my Int @a=((1,2),(3,4)) >>+<< ((5,6),(7,8))', 'mismatch'],
    ['hyper unequal lengths', 'my @a=(1,2) >>+<< (3,4,5)', 'unverifiable'];

for @cases -> [$name, $source, $status] {
    for <fail-on-mismatch fail-on-unverifiable> -> $mode {
        my ($code, $out) = compile($source, :$mode);
        my $fail = $status eq 'mismatch' || ($status eq 'unverifiable' && $mode eq 'fail-on-unverifiable');
        is $code == 0, !$fail, "$name / $mode";
        if $fail { like $out, /'[static:' $status ']'/, "$name classification" }
        else { unlike $out, /'[static:'/ , "$name has no selected errors" }
        unlike $out, /'while evaluating a CHECK'/, "$name never crashes the checker";
        diag $out if ($code == 0) == $fail;
    }
}
done-testing;
