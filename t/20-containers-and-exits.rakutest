use Test;
use lib 't/lib';
use Compile;

my @cases =
    ['dynamic words still inspect later interpolation', 'my $s="x"; my @a=qq:w[$s {my Int $n="bad"; 1}]', 'mismatch'],
    ['return exits for source', 'sub f(--> Int) {for (return 1) {my Int $x="bad"}}; f()', 'ok'],
    ['return exits while condition', 'sub f(--> Int) {while (return 1) {my Int $x="bad"}}; f()', 'ok'],
    ['return exits postfix for source', 'sub f(--> Int) {my Int $x="bad" for (return 1)}; f()', 'ok'],
    ['return exits postfix given source', 'sub f(--> Int) {my Int $x="bad" given (return 1)}; f()', 'ok'],
    ['reverse processors retain string words', 'my Str @a=q:v:w/1 2/', 'ok'],
    ['reverse processors do not create numeric words', 'my Int @a=q:v:w/1 2/', 'mismatch'],
    ['numeric word list', 'my Int @a=<1 2 3>', 'ok'],
    ['string word list', 'my Str @a=<a b c>', 'ok'],
    ['numeric word mismatch', 'my Int @a=<1 bad 3>', 'mismatch'],
    ['singleton word collapse', 'my Int $x=<1>', 'ok'],
    ['plain words retain list', 'my List $x=q:w/a/', 'ok'],
    ['empty word list', 'my Int @a=q:w//', 'ok'],
    ['quoted word atom', 'my Str @a=<<a "b c">>', 'ok'],
    ['processed command stays unknown', 'my Str $x=qx[echo SHOULD_NOT_EXECUTE]', 'unverifiable'],
    ['return skips infix operand', 'sub f(--> Int) {(return 1) + do {my Int $x="bad"; 1}}; f()', 'ok'],
    ['return skips call argument', 'sub g($x,$y) {1}; sub f(--> Int) {g((return 1), do {my Int $x="bad"; 1})}; f()', 'ok'],
    ['return skips named argument', 'sub g(:$x,:$y) {1}; sub f(--> Int) {g(:x(return 1), :y(do {my Int $x="bad"; 1}))}; f()', 'ok'],
    ['return skips list operand', 'sub f(--> Int) {((return 1), do {my Int $x="bad"; 1})}; f()', 'ok'],
    ['return skips composer element', 'sub f(--> Int) {[(return 1), do {my Int $x="bad"; 1}]}; f()', 'ok'],
    ['return skips method call', 'sub f(--> Int) {(return 1).missing(do {my Int $x="bad"; 1})}; f()', 'ok'],
    ['return exits initializer', 'sub f(--> Int) {my Str $x=(return 1)}; f()', 'ok'],
    ['return exits if condition', 'sub f(--> Int) {if (return 1) {my Int $x="bad"}}; f()', 'ok'],
    ['return exits unless condition', 'sub f(--> Int) {unless (return 1) {my Int $x="bad"}}; f()', 'ok'],
    ['return exits ternary condition', 'sub f(--> Int) {(return 1) ?? do {my Int $x="bad"; 1} !! 1}; f()', 'ok'],
    ['throw skips if body', 'try {if die "x" {my Int $x="bad"}}', 'ok'],
    ['private array insertion', 'class C {has Int @!xs; method bad {@!xs.push("bad")}}; C.new.bad', 'mismatch'],
    ['private array indexed write', 'class C {has Int @!xs; method bad {@!xs[0]="bad"}}; C.new.bad', 'mismatch'],
    ['private hash indexed write', 'class C {has Int %!xs; method bad {%!xs<a>="bad"}}; C.new.bad', 'mismatch'],
    ['private array valid mutation', 'class C {has Int @!xs; method good {@!xs.push(1);1}}; C.new.good', 'ok'],
    ['private array list assignment', 'class C {has Int @!xs; method good {@!xs=1,2;1}}; C.new.good', 'ok'],
    ['private array bad list assignment', 'class C {has Int @!xs; method bad {@!xs=1,"bad";1}}; C.new.bad', 'mismatch'],
    ['private array definite insertion', 'class C {has Int:D @!xs; method bad {@!xs.push(Int)}}; C.new.bad', 'mismatch'],
    ['private aggregate not scalar rw', 'class C {has Int @!xs; method bad {sub f($x is rw) {1}; f(@!xs)}}; C.new.bad', 'mismatch'],
    ['constant assignment', 'my constant X=1; X=2', 'mismatch'],
    ['constant scalar assignment', 'my constant $X=1; $X=2', 'mismatch'],
    ['constant container mutation permitted', 'my constant X=[1]; X.push(2)', 'unverifiable'],
    ['array slice valid', 'my Int @a=1,2; @a[0,1]=3,4', 'ok'],
    ['array slice bad element', 'my Int @a=1,2; @a[0,1]=3,"bad"', 'mismatch'],
    ['array slice ignores extra values', 'my Int @a=1,2; @a[0,1]=3,4,"ignored"', 'ok'],
    ['empty slice ignores values', 'my Int @a=1,2; @a[()]="ignored"', 'ok'],
    ['slice missing value resets default', 'my Int @a=1,2; @a[0,1]=3', 'ok'],
    ['slice missing value violates definedness', 'my Int:D @a=1,2; @a[0,1]=3', 'mismatch'],
    ['slice uses explicit default', 'my Int:D @a is default(5)=1,2; @a[0,1]=3', 'ok'],
    ['hash slice valid', 'my Int %h; %h<a b>=1,2', 'ok'],
    ['hash slice bad element', 'my Int %h; %h<a b>=1,"bad"', 'mismatch'],
    ['hash slice ignores extras', 'my Int %h; %h<a b>=1,2,"ignored"', 'ok'],
    ['single index still scalar', 'my Int @a=1,2; @a[0]=3,4', 'mismatch'];

for @cases -> [$name,$source,$status] {
    my ($code,$out) = compile($source,:mode<fail-on-unverifiable>);
    is $code == 0, $status eq 'ok', $name;
    like $out, /'[static:' $status ']'/, "$name diagnostic" unless $status eq 'ok';
    unlike $out, /'while evaluating a CHECK' | 'Use of uninitialized value'/,
        "$name has no internal error";
    diag $out if ($code == 0) != ($status eq 'ok');
    if $status eq 'unverifiable' {
        my ($permissive-code,$permissive-out)=compile($source,:mode<fail-on-mismatch>);
        is $permissive-code, 0, "$name accepted by mismatch policy";
    }
}
done-testing;
